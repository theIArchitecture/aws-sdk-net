# AWS SDK Hardcoded Credentials in Configuration Files Rule
# Detects actual hardcoded AWS credentials in app.config/web.config files
# Based on real patterns found in AWS SDK .NET codebase

RULE "AWS-CONFIG-HARDCODED-CREDENTIALS" : IHealerArchitecture
  ID: "AWS-CONFIG-CREDENTIALS-001"
  DESCRIPTION: "Hardcoded AWS credentials detected in configuration files - must use environment variables or credential profiles"
  SEVERITY: Fatal
  CATEGORY: "AWS_Security_Critical"
  APPLIES_TO: ["csharp"]

  ARCHITECTURAL_CONTEXT:
    PROJECT_TYPE: "AWS_DOTNET_APPLICATION"
    COMPLIANCE_REQUIREMENTS: ["SOC2", "PCI_DSS", "Security_Audit", "Zero_Secrets_In_Code"]
    ORGANIZATION_STANDARDS: ["AWS_Security_Best_Practices", "OWASP_Top_10"]
    TECHNOLOGY_STACK: ["csharp", "dotnet", "aws-sdk", "configuration"]
    SECURITY_LEVEL: "Enterprise_Production_Critical"

  EDUCATION:
    DOCS_URL: "https://docs.aws.amazon.com/sdk-for-net/v3/developer-guide/creds-assign.html"
    WHY_IT_MATTERS: "{{SILO:PROJECT_TYPE}} credentials in app.config expose AWS infrastructure to {{SILO:COMPLIANCE_REQUIREMENTS}} violations and breaches"
    BUSINESS_IMPACT: "Config file credentials cause $4.45M average breach cost - exposed in source control and deployment packages for {{SILO:PROJECT_TYPE}}"
    QUICK_FIX: "Use environment variables, AWS credential profiles, or IAM roles for {{SILO:SECURITY_LEVEL}} credential management"

  ARCHITECTURAL_LAYERS:
    CREDENTIAL_SOURCES: ["Environment_Variables", "Credential_Profiles", "IAM_Roles", "SSM_Parameter_Store"]
    SECURITY_PATTERNS: ["Zero_Hardcoded_Secrets", "Credential_Rotation", "Principle_Of_Least_Privilege"]
    COMPLIANCE_FRAMEWORKS: ["SOC2_Type_II", "PCI_DSS", "GDPR_Article_32"]

  DETECT:
    PATTERNS:
      csharp:
        # Actual hardcoded access keys in config
        - CONFIG_ACCESSKEY_LITERAL: "<add\\s+key=\"AWSAccessKey\"\\s+value=\"AKIA[0-9A-Z]{16}\""
        - CONFIG_SECRETKEY_LITERAL: "<add\\s+key=\"AWSSecretKey\"\\s+value=\"[A-Za-z0-9+/]{40}\""

        # App.config/web.config with actual credential values
        - APPSETTINGS_ACCESSKEY: "appConfig\\[\"AWSAccessKey\"\\].*\"AKIA"
        - APPSETTINGS_SECRETKEY: "appConfig\\[\"AWSSecretKey\"\\].*\"[A-Za-z0-9+/]{40}\""

        # ConfigurationManager with literal credentials
        - CONFIGMANAGER_HARDCODED: "ConfigurationManager\\.AppSettings\\[\"AWS.*\"\\].*=.*\"AKIA"

        # BasicAWSCredentials with string literals (not variables)
        - BASIC_CREDS_LITERAL: "new\\s+BasicAWSCredentials\\s*\\(\\s*\"AKIA[0-9A-Z]{16}\"\\s*,\\s*\"[A-Za-z0-9+/]{40}\""

  VIOLATIONS:
    - "{{SILO:PROJECT_TYPE}} SECURITY: Hardcoded AWS Access Key in config file violates {{SILO:COMPLIANCE_REQUIREMENTS}}"
    - "{{SILO:PROJECT_TYPE}} SECURITY: Hardcoded AWS Secret Key in config violates {{SILO:SECURITY_LEVEL}} standards"
    - "{{SILO:PROJECT_TYPE}} SECURITY: BasicAWSCredentials with literal strings violates {{SILO:COMPLIANCE_REQUIREMENTS}}"

  FIXES:
    csharp:
      - REPLACE: "<add key=\"AWSAccessKey\" value=\"AKIA"
      - WITH: "<!-- Use environment variable AWS_ACCESS_KEY_ID or credential profile -->\n    <!-- <add key=\"AWSProfileName\" value=\"default\" /> -->"
      - TEACHING: "Remove hardcoded credentials from config files for {{SILO:COMPLIANCE_REQUIREMENTS}} - use AWS credential profiles or environment variables"

      - REPLACE: "new BasicAWSCredentials(\"AKIA"
      - WITH: "// Use environment variables or credential profiles\n    var credentials = FallbackCredentialsFactory.GetCredentials();"
      - TEACHING: "Use FallbackCredentialsFactory for automatic credential resolution in {{SILO:PROJECT_TYPE}}"

      - REPLACE: "appConfig[\"AWSAccessKey\"]"
      - WITH: "Environment.GetEnvironmentVariable(\"AWS_ACCESS_KEY_ID\")"
      - TEACHING: "Load credentials from environment variables for {{SILO:SECURITY_LEVEL}} security"

  WHITELISTED_PATTERNS:
    - "Environment\\.GetEnvironmentVariable\\(\"AWS_"
    - "FallbackCredentialsFactory\\.GetCredentials"
    - "ProfileManager\\.GetAWSCredentials"
    - "AWSProfileName"
    - "IAMRoleARN"

  PARTIAL_HEALING:
    csharp:
      - ACTION: "Replace hardcoded credentials with environment variable or profile-based credential loading"
      - LIMITATION: "Cannot automatically create credential profiles or configure IAM roles - requires infrastructure setup"
      - DOWNGRADE_TO: "CRITICAL_WARNING"
      - EDUCATIONAL_NOTE: "Configure AWS credential profiles or IAM roles for production {{SILO:PROJECT_TYPE}} deployment"

  META_ARCHITECTURE:
    HEALING_PRIORITY: 1
    BREAKING_CHANGE: false
    BUSINESS_IMPACT: "Hardcoded credentials expose entire AWS infrastructure - $4.45M average breach cost"
    AUTO_HEAL_SUCCESS_RATE: "90%"
    GOVERNANCE_LEVEL: "CRITICAL_SECURITY_ENFORCEMENT"

  IDENTIFIER: "AWS-CONFIG-CREDENTIALS-001"
  IS_VALID: true
  CODE_TYPE: "Architecture"
  CURRENT_STATE: "Active"

  HEALING_FIXES: "Complete fixes for csharp configuration credential patterns"
  HEALING_PRIORITY_METHOD: 1
  HEALING_SUCCESS_RATE: 0.90
  CAN_AUTO_HEAL: true
  FIX_SAFETY_VALIDATED: true
  FIX_COMPLETENESS_VALIDATED: true
  FIX_TEACHING_INCLUDED: true

END RULE
