<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference the SDK project (development mode - would be PackageReference in production) -->
    <ProjectReference Include="../../../../IArchitecture-DotNet/IArchitecture.Plugin.SDK/IArchitecture.Plugin.SDK.csproj" />
    <!-- Reference IArchitecture.Shared for DetectionPattern model -->
    <ProjectReference Include="../../../../IArchitecture-DotNet/IArchitecture.Shared/IArchitecture.Shared.csproj" />
  </ItemGroup>

  <!-- xUnit test packages -->
  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
  </ItemGroup>

  <!-- Don't copy plugin.json to build output - it stays in plugin root alongside copied DLL -->
  <ItemGroup>
    <None Update="plugin.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Post-build: Deploy plugin to runtime location with all dependencies -->
  <Target Name="DeployPlugin" AfterTargets="Build">
    <PropertyGroup>
      <DeployDir>E:\Protected\VendorCodeArchive\.iarch\plugins\semgrep-validator\</DeployDir>
    </PropertyGroup>

    <!-- Copy plugin DLL -->
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(DeployDir)" />

    <!-- Copy SDK DLL -->
    <Copy SourceFiles="..\..\Libraries\IArchSDK\IArchitecture.Plugin.SDK.dll" DestinationFolder="$(DeployDir)" />

    <!-- Copy plugin.json manifest -->
    <Copy SourceFiles="$(ProjectDir)plugin.json" DestinationFolder="$(DeployDir)" />

    <!-- Copy FFI DLLs if they exist in Libraries\Semgrep\ffi -->
    <ItemGroup>
      <SemgrepFFI Include="..\..\Libraries\Semgrep\ffi\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(SemgrepFFI)" DestinationFolder="$(DeployDir)ffi\%(RecursiveDir)" Condition="Exists('..\..\Libraries\Semgrep\ffi')" />

    <Message Importance="High" Text="Deployed plugin to $(DeployDir)" />
  </Target>

  <!-- Copy FFI DLLs to test output directory for xUnit tests -->
  <Target Name="CopyFFIForTests" AfterTargets="Build">
    <ItemGroup>
      <FFIFiles Include="..\..\Libraries\Semgrep\ffi\*.dll" />
      <FFIFiles Include="..\..\Libraries\Semgrep\ffi\*.so" />
    </ItemGroup>
    <Copy SourceFiles="@(FFIFiles)" DestinationFolder="$(OutputPath)" Condition="Exists('..\..\Libraries\Semgrep\ffi')" />
  </Target>

</Project>
